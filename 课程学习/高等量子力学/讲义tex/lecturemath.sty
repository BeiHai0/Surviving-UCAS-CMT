% 中文数学与物理讲义通用宏包；复制本文件到其他项目即可使用。
% 建议配合 ctexbook 或 ctexart，使用 XeLaTeX 编译。
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{lecturemath}[2026/09/19 v1.0 Chinese math and physics handout]

\RequirePackage[margin=2.5cm]{geometry} % 设置纸张页边距。
\RequirePackage{amsmath}              % 提供 align、cases 等数学公式环境。
\RequirePackage{amssymb}              % 提供额外数学符号及黑板粗体字母。
\RequirePackage{mathtools}            % 扩展 amsmath，提供 \coloneqq 等命令。
\RequirePackage{amsthm}               % 定义定理类环境及 proof 证明环境。
\RequirePackage{braket}               % 提供 \Bra、\Ket、\Braket 等 Dirac 记号。
\RequirePackage{bm}                   % 用 \bm 排版粗体数学向量和希腊字母。
\RequirePackage{graphicx}             % 用 \includegraphics 插入图片。
\RequirePackage{booktabs}             % 提供三线表的横线命令。
\RequirePackage{xcolor}               % 定义颜色，供超链接等使用。
\RequirePackage{hyperref}             % 生成可点击的目录、交叉引用及 PDF 书签。
\RequirePackage{bookmark}             % 改善 PDF 书签的组织与生成。

% 标题字号、字体和间距沿用群论讲义；正文标题统一黑色。
\definecolor{accent}{HTML}{244C65} % 目录章、节条目的蓝色。
\ifcsname c@chapter\endcsname
  \ctexset{
    chapter={format=\Huge\bfseries\sffamily\color{black},name={第,章},
      number=\arabic{chapter},beforeskip=8pt,afterskip=28pt}
  }
\fi
\ctexset{
  section={format=\Large\bfseries\sffamily\color{black},beforeskip=22pt,afterskip=10pt},
  subsection={format=\large\bfseries\sffamily\color{black},beforeskip=16pt,afterskip=8pt},
  subsubsection={format=\normalsize\bfseries\sffamily\color{black},beforeskip=12pt,afterskip=6pt}
}
\setcounter{secnumdepth}{2} % 正文编号到小节（1.1.1）。
\setcounter{tocdepth}{2}    % 目录列出章、节和小节。

% 项目专属的 pdftitle、pdfauthor 请在主文件中用 \hypersetup 设置。
\hypersetup{
  colorlinks=true,
  linkcolor=black,
  citecolor=green!40!black,
  urlcolor=blue!60!black
}

% 目录调参：各级字号及基线间距；配色、行距和留白集中在下方。
\newcommand{\tocchaptersize}{\fontsize{16pt}{18pt}\selectfont}
\newcommand{\tocsectionsize}{\fontsize{14pt}{16pt}\selectfont}
\newcommand{\tocsubsectionsize}{\fontsize{12pt}{14.5pt}\selectfont}
% 主文件用 \lecturetableofcontents 生成目录；设置仅在目录内生效。
\newcommand{\lecturetableofcontents}{%
  \begingroup
  \renewcommand{\baselinestretch}{1.10}% 目录行距倍率。
  \normalsize
  \setlength{\parskip}{2pt}% 目录条目间距。
  \ifcsname c@chapter\endcsname
    \ctexset{chapter/beforeskip=0pt,chapter/afterskip=18pt}% “目录”标题上下留白。
    \let\originaltocchapter\l@chapter
    \renewcommand{\l@chapter}[2]{\begingroup\tocchaptersize\color{accent}\hypersetup{linkcolor=accent}\originaltocchapter{##1}{##2}\endgroup}%
  \else
    \ctexset{section/beforeskip=0pt,section/afterskip=18pt}% 兼容 ctexart。
  \fi
  % 章、节为 accent 蓝色，小节为黑色；链接颜色同步。
  \let\originaltocsection\l@section
  \let\originaltocsubsection\l@subsection
  \renewcommand{\l@section}[2]{\begingroup\tocsectionsize\bfseries\color{accent}\hypersetup{linkcolor=accent}\originaltocsection{##1}{##2}\endgroup}%
  \renewcommand{\l@subsection}[2]{\begingroup\tocsubsectionsize\color{black}\hypersetup{linkcolor=black}\originaltocsubsection{##1}{##2}\endgroup}%
  \tableofcontents
  \clearpage
  \endgroup
}

% 定理等共享计数器；书籍按章编号，文章按节编号。
\theoremstyle{plain}
\ifcsname c@chapter\endcsname
  \newtheorem{theorem}{定理}[chapter]
\else
  \newtheorem{theorem}{定理}[section]
\fi
\newtheorem{lemma}[theorem]{引理}
\newtheorem{proposition}[theorem]{命题}
\newtheorem{corollary}[theorem]{推论}
\theoremstyle{definition}
\newtheorem{definition}[theorem]{定义}
\newtheorem{example}[theorem]{例}
\theoremstyle{remark}
\newtheorem{remark}[theorem]{注}
\renewcommand{\proofname}{证明} % proof 由 amsthm 提供，无需再次定义。

% 常用记号；自然常数始终使用正体 \mathrm{e}。
\newcommand{\R}{\mathbb{R}}
\newcommand{\C}{\mathbb{C}}
\newcommand{\dd}{\mathop{}\!\mathrm{d}} % 积分中的正体微分符号。
\DeclareMathOperator{\Tr}{Tr}
\endinput
